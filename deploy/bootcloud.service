# Reference copy of /etc/systemd/system/bootcloud.service on the server.
# The FastAPI app, served by uvicorn directly on port 443 with HTTPS.
[Unit]
Description=BootCloud FastAPI app (uvicorn, HTTPS on 443)
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/bootcloud/site
Environment=PYTHONDONTWRITEBYTECODE=1
# systemd reads the root-only certificate files and hands copies to the service (%d)
LoadCredential=fullchain.pem:/etc/letsencrypt/live/bootcloud.eu/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/bootcloud.eu/privkey.pem
ExecStart=/srv/bootcloud-venv/bin/uvicorn main:app --host 0.0.0.0 --port 443 \
    --ssl-certfile %d/fullchain.pem --ssl-keyfile %d/privkey.pem
# allow binding port 443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
